# =============================================================================
# KitPay SolutionIA - environment variables
# =============================================================================
# Copy this file to .env.local and fill in each value.
# Never commit .env.local to a public repository.

# -----------------------------------------------------------------------------
# Supabase (mandatory)
# -----------------------------------------------------------------------------
# Create a project at https://supabase.com then read Settings > API.
# Use the new key format (sb_publishable_... and sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# Public app URL (used for hosted_url, email links, redirects)
# -----------------------------------------------------------------------------
# Local:  http://localhost:3000
# Prod:   https://your-domain.example
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Default merchant (shown in the example intent on the home page)
# -----------------------------------------------------------------------------
# The real per-merchant phone lives in the merchant_operators table, filled
# during the onboarding flow. This fallback is used only when the sandbox
# home page has no merchant context.
NEXT_PUBLIC_MERCHANT_PHONE=+222 46 XX XX XX
NEXT_PUBLIC_MERCHANT_NAME=KitPay Demo

# -----------------------------------------------------------------------------
# Admin dashboard (super-admin only)
# -----------------------------------------------------------------------------
# Used by /api/admin/* routes. Generate with: openssl rand -hex 32
# Must be at least 16 characters and not the default sentinel.
# The server refuses to start admin routes until this is set correctly.
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Email receipts (Resend)
# -----------------------------------------------------------------------------
# Sign up at https://resend.com, then Settings > API Keys > Create API Key.
# In test mode Resend only delivers to your own account address; verify a
# domain to send to customers.
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM=KitPay <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# Telegram notifications (optional but recommended)
# -----------------------------------------------------------------------------
# 1) Talk to @BotFather on Telegram, create a bot with /newbot, copy the token.
# 2) Create a private channel, add the bot as admin.
# 3) Send a first message in the channel, then call
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "chat.id" (a negative number starting with -100...).
TELEGRAM_BOT_TOKEN=123456789:AA_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=-1001234567890

# -----------------------------------------------------------------------------
# Shared secrets for machine-to-machine endpoints
# -----------------------------------------------------------------------------
# Generate each with: openssl rand -hex 32   (or any 32+ char random string).

# Required. Protects POST /api/sms-ingest (called by the phone SMS forwarder).
WEBHOOK_SECRET=change-me-32-char-random-string-for-sms-ingest

# Required. Protects POST /api/cron/* endpoints (webhook delivery worker,
# expire-intents, finalize-pending). Called every 30-60s by cron-job.org or
# an equivalent external scheduler.
CRON_SECRET=change-me-32-char-random-string-for-cron

# -----------------------------------------------------------------------------
# Sandbox / demo endpoint (/api/demo)
# -----------------------------------------------------------------------------
# UUID of the merchant that owns /sandbox. Leave empty to disable /api/demo.
# Fallback to "first merchant" is intentionally removed for safety.
SANDBOX_MERCHANT_ID=
